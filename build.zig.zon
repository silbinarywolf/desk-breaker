// https://github.com/ziglang/zig/blob/master/doc/build.zig.zon.md
.{
    .name = .desk_breaker,
    .version = "0.0.0",
    .minimum_zig_version = "0.16.0",
    .zig_version = "0.17.0",
    .dependencies = .{
        .jaetools = .{
            .path = "jaetools",
        },
        .wuffs = .{
            .path = "third-party/wuffs",
        },
        // NOTE(jae): 2026-10-16
        // Temporarily use Wayland/Wayland-Protocols to generate 'wayland_custom/wayland-gen-*.zig' files
        .wayland = .{
            .url = "git+https://codeberg.org/ifreund/zig-wayland.git#94db7ba4e0a6b4780a16dbc74c7a2c88f1ebf502",
            .hash = "wayland-0.8.0-dev-lQa1kuf8AQCeoam8G-XPyaIYvIOk3_wgsspwi4nT_L5q",
        },
        .wayland_protocols = .{
            .url = "git+https://gitlab.freedesktop.org/wayland/wayland-protocols.git#35d9638cf0c3f0bbf0c42996580a284f3d8ce564",
            .hash = "N-V-__8AADU4EQCgw58dBpFde-8kTfx4ssoZsNNd97_Ba63j",
            .lazy = true,
        },
        // NOTE(jae): 2025-04-13
        // Used as an experiment to run Desk Breaker on Android and validate the Zig Android SDK against a more complicated
        // project.
        .android = .{
            .path = "../zig-android-sdk",
            //.url = "git+https://github.com/silbinarywolf/zig-android-sdk#e72f0bb19b0b770fe65b74515594fea62ee369cf",
            //.hash = "android-0.3.0-7iz7QkgyAgCCCsGXARq_j2DYLmIZoVlDh5ugZUUhKxAQ",
        },
        // NOTE(jae): 2024-11-05
        // Used as an experiment to run Desk Breaker in browser
        .emscripten = .{
            .path = "third-party/emscripten",
            .lazy = true,
        },
        // NOTE(jae): 2024-11-05
        // Used as an experiment to run Desk Breaker on a Playstation Portable
        .psp = .{
            .path = "third-party/psp",
            .lazy = true,
        },
    },
    .paths = .{
        "LICENSE",
        "README.md",
        "build.zig",
        "build.zig.zon",
        "src",
    },
    .fingerprint = 0x54c45984eb95c957,
}
